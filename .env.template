# Velvet Sync · Template de Variables de Entorno
# Copia este archivo a .env y reemplaza los valores

# ═══════════════════════════════════════════════════════════════
# SUPABASE (Backend Principal)
# ═══════════════════════════════════════════════════════════════
# URL de tu proyecto Supabase
SUPABASE_URL=tu-supabase-url
# API Key anónima de Supabase
SUPABASE_ANON_KEY=tu-supabase-anon-key

# ═══════════════════════════════════════════════════════════════
# CATALOG API (Secundario - Opcional)
# ═══════════════════════════════════════════════════════════════
# URL de Supabase para catálogo de dispositivos
CATALOG_SUPABASE_URL=tu-catalog-supabase-url
# API Key para catálogo
CATALOG_SUPABASE_KEY=tu-catalog-supabase-key

# ═══════════════════════════════════════════════════════════════
# OPENROUTER API (Proveedor de IA - Gemini, GPT, Claude, etc.)
# ═══════════════════════════════════════════════════════════════
# Obtén tu API Key en: https://openrouter.ai/keys
OPENROUTER_API_KEY=tu-openrouter-api-key

# ═══════════════════════════════════════════════════════════════
# GOOGLE GEMINI API (Proveedor de IA Alternativo)
# ═══════════════════════════════════════════════════════════════
# Obtén tu API Key en: https://makersuite.google.com/app/apikey
GOOGLE_API_KEY=tu-google-api-key

# ═══════════════════════════════════════════════════════════════
# NOTAS DE SEGURIDAD
# ═══════════════════════════════════════════════════════════════
# ⚠️ NUNCA commites el archivo .env a Git
# ⚠️ Este archivo (.env.template) es seguro para commitear
# ⚠️ Rota tus API keys cada 90 días por seguridad
